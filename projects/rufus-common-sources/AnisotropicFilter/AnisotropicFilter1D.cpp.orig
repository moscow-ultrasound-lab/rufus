void	AnisotropicFilter1D::InitNames()
{
	filter_names[e_left] = "Left";
	filter_names[e_right] = "Right";
	filter_names[e_original] = "Original";
}


void AnisotropicFilter1D::ComputePrincipalComponents()
{
	slightly_blured_original.CopyData(original);
	blured_left.CopyData(original);
	blured_right.CopyData(original);

	ExponentialBlur1D(slightly_blured_original, compare_filter_factor, biexponential_blur);
	ExponentialBlur1D(blured_right, main_filter_factor, exponential_blur_forward);
	ExponentialBlur1D(blured_left, main_filter_factor, exponential_blur_reverse);
	RealFunctionF32 sum(blured_right+blured_left);


	difference_left.subtract(slightly_blured_original, blured_left);
	difference_right.subtract(slightly_blured_original, blured_right);




	sides_difference.subtract(blured_left, blured_right);// NB то же, что производная от biexp_blur главным радиусом
	differences_sum.add(difference_left, difference_right);// разница между biexp_blur малым и главным радиусом. де факто ФВЧ
	components_all.row(e_left) = blured_left;
	components_all.row(e_right) = blured_right;
	components_all.row(e_original) = original;
	difference_all.row(e_left) = difference_left;
	difference_all.row(e_right) = difference_right;
	difference_all.row(e_original) = (original - slightly_blured_original);

	ExponentialBlur1D(difference_all.row(e_left), main_filter_factor, biexponential_blur);
	ExponentialBlur1D(difference_all.row(e_right), main_filter_factor, biexponential_blur);
	ExponentialBlur1D(difference_all.row(e_original), main_filter_factor, biexponential_blur);

//	sides_difference_derivative то же, что и differences_sum
}

void AnisotropicFilter1D::ComputeComparedComponents()
{
	slightly_blured_cleared.CopyData(combined);
	post_blured_left.CopyData(combined);
	post_blured_right.CopyData(combined);

	ExponentialBlur1D(slightly_blured_cleared, compare_filter_factor, biexponential_blur);
	ExponentialBlur1D(post_blured_right, main_filter_factor, exponential_blur_forward);
	ExponentialBlur1D(post_blured_left, main_filter_factor, exponential_blur_reverse);

	post_difference_left.subtract(slightly_blured_cleared, post_blured_left);
	post_difference_right.subtract(slightly_blured_cleared, post_blured_right);

	post_sides_difference.subtract(post_blured_left, post_blured_right);// NB то же, что производная от biexp_blur главным радиусом
	post_differences_sum.add(post_difference_left, post_difference_right);// разница между biexp_blur малым и главным радиусом. де факто ФВЧ

														   //	sides_difference_derivative то же, что и differences_sum
														   //	ExponentialBlur1D(sides_difference_derivative, small_filter_factor, biexponential_blur);
}

