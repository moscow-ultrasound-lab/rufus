void	AnisotropicFilter1D::LoadFunction(const function_t &f)
{
	SetSampleSize(f.size());
	original.CopyData(f);
}


void	AnisotropicFilter1D::Apply(function_t &f, algorithm_type_t &algorithm_type)
{
	LoadFunction(f);
	InitNames();
	ComputePrincipalComponents();
	ApplyAlgorithmType(algorithm_type);
	ComputeComparedComponents();
	f.CopyData(combined);
}


void	AnisotropicFilter1D::SetSampleSize(size_t in_size)
{
	if(in_size==graph_size) return;

	graph_size = in_size;
	filter_names.resize(components_number);
	components_all.realloc(components_number, graph_size);
	mask_all.realloc(components_number, graph_size);
	difference_all.realloc(components_number, graph_size);
	components_all.realloc(components_number, graph_size);
	original.realloc(graph_size);
	blured_left.realloc(graph_size);
	blured_right.realloc(graph_size);

	difference_left.realloc(graph_size);
	difference_right.realloc(graph_size);
	differences_sum.realloc(graph_size);
	sides_difference.realloc(graph_size);

	slightly_blured_cleared.realloc(graph_size);
	post_blured_right.realloc(graph_size);
	post_blured_left.realloc(graph_size);
	post_difference_left.realloc(graph_size);
	post_difference_right.realloc(graph_size);
	post_differences_sum.realloc(graph_size);
	post_sides_difference.realloc(graph_size);
	slightly_blured_original.realloc(graph_size);

	combined.realloc(graph_size);

	mask_left.realloc(graph_size);
	mask_right.realloc(graph_size);
	mask_original.realloc(graph_size);
}



void	AnisotropicFilter1D::ApplyAlgorithmType(algorithm_type_t &algorithm_type)
{
	switch (algorithm_type)
	{
	case e_algorithm_left_right:
		ComputeClearedSignal_LeftRight();
		break;

	case e_algorithm_cross:
		ComputeClearedSignal_Cross();
		break;

	case e_algorithm_hyperbola:
		ComputeClearedSignal_Hyperbola();
		break;

	}
}


void	AnisotropicFilter1D::ComputeClearedSignal_LeftRight()
{
	// список критериев
	// 1. fabs(left-right) < noise_threshold1 ==> left+right
	// 1'. fabs(differences_sum) < noise_threshold1 ==> left+right
	// 2. fabs(difference_right) < noise_threshold2 ==> right
	// 3. fabs(difference_left) < noise_threshold3 ==>left

	combined.fill(0);
	mask_all.fill(0);
	RealFunctionF32 mask_sum(combined);
	mask_original.fill(0);
	for(size_t i = 0; i < graph_size; ++i)
	{
		ComputeMasksRow(difference_all.col(i), mask_all.col(i), priority_vector);
		combined[i] = ComputeCombinedImage(components_all.col(i), mask_all.col(i));
	}
}

void	AnisotropicFilter1D::Show2DComponents()
{
	DisplayMathFunction2D(mask_all, "masks all");
	DisplayMathFunction2D(components_all, "blured all");
	DisplayMathFunction2D(difference_all, "difference all");
}

void	AnisotropicFilter1D::ComputeClearedSignal_Cross()
{
	// список критериев
	// 1. fabs(f'') > noise_threshold3 ==> original
	// 2. fabs(f'') < noise_threshold1 || fabs(f') < noise_threshold1 ==> left+right
	// 3. sign(p1)=sign(p2)  ==> left
	// 4. sign(p1)!=sign(p2)  ==> right

	combined.fill(0);
	noise_threshold1/=square(main_filter_radius);
	double a1 = noise_threshold1;
	double a3 = noise_threshold1 * 2;

	for (size_t i = 0; i < graph_size; ++i)
	{
		double	p2 = differences_sum[i];
		double	p1 = sides_difference[i];

		if (fabs(p2) > a3)
		{
			mask_left[i] = 0;
			mask_right[i] = 0;
			mask_original[i] = 1;
		}

		else if (fabs(p2)<a1 || fabs(p1)<a1)
		{
			mask_left[i] = 0.5;
			mask_right[i] = 0.5;
			mask_original[i] = 0;
		}

		else if (sign(p1)==sign(p2))
		{
			mask_left[i] = 1;
			mask_right[i] = 0;
			mask_original[i] = 0;
		}

		else if (sign(p1) != sign(p2))
		{
			mask_left[i] = 0;
			mask_right[i] = 1;
			mask_original[i] = 0;
		}


		combined[i] = original[i] * mask_original[i] + blured_left[i] * mask_left[i] + blured_right[i] * mask_right[i];
	}

}

void	AnisotropicFilter1D::ComputeClearedSignal_Hyperbola()
{
	// список критериев
	// 1. fabs(f'') > noise_threshold3 ==> original
	// 2. fabs(f'') < noise_threshold1 || fabs(f') < noise_threshold1 ==> left+right
	// 3. sign(p1)=sign(p2)  ==> left
	// 4. sign(p1)!=sign(p2)  ==> right

	combined.fill(0);
	noise_threshold1 /= square(main_filter_radius);
	double a1 = noise_threshold1;
	double a3 = noise_threshold1*2;
	double hyperbola = square(a1);

	for (size_t i = 0; i < graph_size; ++i)
	{
		double	p2 = differences_sum[i];
		double	p1 = sides_difference[i];
		 
		if (fabs(p2) > a3)
		{
			mask_left[i] = 0;
			mask_right[i] = 0;
			mask_original[i] = 1;
		}

		else if (fabs(p2*p1) < hyperbola)
		{
			mask_left[i] = 0.5;
			mask_right[i] = 0.5;
			mask_original[i] = 0;
		}

		else if (p2*p1 > 0)
		{
			mask_left[i] = 1;
			mask_right[i] = 0;
			mask_original[i] = 0;
		}

		else if (p2*p1 < 0)
		{
			mask_left[i] = 0;
			mask_right[i] = 1;
			mask_original[i] = 0;
		}


// 		else if (fabs(p2)<a1 || fabs(p1)<a1)
// 		{
// 			mask_left[i] = 0.5;
// 			mask_right[i] = 0.5;
// 			mask_original[i] = 0;
// 		}
// 		else if (sign(p1)==sign(p2))
// 		{
// 			mask_left[i] = 1;
// 			mask_right[i] = 0;
// 			mask_original[i] = 0;
// 		}
// 		else if (sign(p1) != sign(p2))
// 		{
// 			mask_left[i] = 0;
// 			mask_right[i] = 1;
// 			mask_original[i] = 0;
// 		}

		
		combined[i] = original[i] * mask_original[i] + blured_left[i] * mask_left[i] + blured_right[i] * mask_right[i];
	}


}


void	AnisotropicFilter1D::ComputeClearedSignal0()
{
	for(size_t i = 0; i < graph_size; ++i)
	{
		if(differences_sum[i]>large_step)
		{
			combined[i] = original[i];
		}
		else if(fabs(sides_difference[i])>step_diff)
		{
			if((sides_difference[i] < 0))
			{
				combined[i] = blured_left[i];
				if(fabs(differences_sum[i])<step_der)
				{
					combined[i] = condition_01*blured_left[i] + (1-condition_01)*blured_right[i];
				}
				else if(differences_sum[i] < 0)
				{
					combined[i] = blured_left[i];
				}
				else
				{
					combined[i] = blured_right[i];
				}
			}
			else if((sides_difference[i] > 0))
			{
				if(fabs(differences_sum[i])<step_der)
				{
					combined[i] = condition_02*blured_left[i] + (1-condition_02)*blured_right[i];
				}
				else if(differences_sum[i] > 0)
				{
					combined[i] = blured_left[i];
				}
				else
				{
					combined[i] = blured_right[i];
				}
			}

		}
		else
		{
			if((sides_difference[i] < 0))
			{
				combined[i] = blured_left[i];
				if(fabs(differences_sum[i]) < step_der)
				{
					combined[i] = condition_03*blured_left[i] + (1-condition_03)*blured_right[i];
				}
				else if(differences_sum[i] < 0)
				{
					combined[i] = blured_left[i];
				}
				else
				{
					combined[i] = blured_right[i];
				}
			}
			else if((sides_difference[i] > 0))
			{
				if(fabs(differences_sum[i]) < step_der)
				{
					combined[i] = condition_04*blured_left[i] + (1-condition_04)*blured_right[i];
				}
				else if(differences_sum[i] > 0)
				{
					combined[i] = blured_left[i];
				}
				else
				{
					combined[i] = blured_right[i];
				}
			}
		}
	}
}




